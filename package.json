{
  "name": "caveman-docs",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "dev": "npm run content && vite dev --port 3010",
    "build": "npm run content && node scripts/check-public.mjs && vite build",
    "start": "vite preview --port 3010",
    "deploy": "npm run build && vinext-cloudflare deploy --skip-build",
    "dev:next": "npm run content && next dev --port 3010",
    "build:next": "npm run content && node scripts/check-public.mjs && next build",
    "lint": "npm run content && next typegen && tsc --noEmit",
    "check:public": "node scripts/check-public.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@vinext/cloudflare": "^1.3.0",
    "clsx": "2.1.1",
    "github-slugger": "^2.0.0",
    "lucide-react": "0.555.0",
    "mermaid": "^11.17.2",
    "next": "16.2.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "2.6.0",
    "unist-util-visit": "^5.2.0",
    "vinext": "^1.4.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.7",
    "@types/mdx": "^2.0.14",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "autoprefixer": "10.4.21",
    "cf": "^1.0.0-beta.25",
    "postcss": "8.5.18",
    "tailwindcss": "3.4.18",
    "typescript": "5.9.3",
    "vite": "^8.3.0"
  },
  "type": "module"
}
